# API -> OVMS internal network address. Do not expose this port by default.
OVMS_URL=http://ovms:8000
OVMS_DEFAULT_MODEL=qwen3-1.7b
OVMS_MODEL_NAMES=qwen3-1.7b=qwen3-1.7b,qwen3-8b=qwen3-8b
REQUEST_TIMEOUT_SECONDS=60
CONNECT_TIMEOUT_SECONDS=5
MAX_INPUT_CHARS=12000
DEFAULT_MAX_TOKENS=128
MAX_TOKENS_LIMIT=512
DEFAULT_TEMPERATURE=0.2
MAX_CONCURRENCY=2
MAX_SSE_EVENT_BYTES=1000000

# OVMS deployment
OVMS_IMAGE=openvino/model_server:2026.3.1-gpu
OVMS_MODEL_REVISION=main
OVMS_MAX_NUM_SEQS=1

# Windows WSL2 Docker Desktop values. Override only after validating the host.
OVMS_HOST_DEVICE=/dev/dxg
OVMS_CONTAINER_DEVICE=/dev/dxg
OVMS_WSL_LIB=/usr/lib/wsl
